{
  "project_name": "transcendence",
  "networks": ["transcendence_net"],
  "volumes": ["postgres_data"],
  "secrets": {
    "postgres_password": "POSTGRES_P@SSWORD",
    "jwt_secret": "JWT_SECRET"
  },
  "services": {
    "nginx": {
      "build": "../infra/nginx",
      "container_name": "transcendence_nginx",
      "restart": "unless-stopped",
      "ports": ["8080:80"],
      "depends_on": ["frontend", "backend"],
      "networks": ["transcendence_net"]
    },
    "frontend": {
      "build": "../core/frontend",
      "container_name": "transcendence_frontend",
      "restart": "unless-stopped",
      "env": {
        "NODE_ENV": "development"
      },
      "networks": ["transcendence_net"]
    },
    "backend": {
      "build": "../core/backend",
      "container_name": "transcendence_backend",
      "restart": "unless-stopped",
      "env": {
        "PORT": "4000",
        "NODE_ENV": "development",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_USER": "transcendence",
        "DB_NAME": "transcendence_db",
        "DB_PASSWORD_FILE": "/run/secrets/postgres_password",
        "JWT_SECRET_FILE": "/run/secrets/jwt_secret"
      },
      "secrets": ["postgres_password", "jwt_secret"],
      "depends_on": ["postgres"],
      "networks": ["transcendence_net"]
    },
    "postgres": {
      "image": "postgres:16-alpine",
      "container_name": "transcendence_postgres",
      "restart": "unless-stopped",
      "volumes": ["postgres_data:/var/lib/postgresql/data"],
      "env": {
        "POSTGRES_USER": "transcendence",
        "POSTGRES_DB": "transcendence_db",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/postgres_password"
      },
      "secrets": ["postgres_password"],
      "networks": ["transcendence_net"]
    }
  }
}
